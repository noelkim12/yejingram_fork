# ACME / TLS
CADDY_ACME_EMAIL=you@example.com

# UI domain basic auth (used only on ygram.noelkim12.dev)
YGRAM_BASIC_AUTH_USER=noel
YGRAM_BASIC_AUTH_HASH=$2a$14$replace-with-output-of-caddy-hash-password

# Static frontend build directory
YGRAM_DIST_ROOT=/home/noel/projects/personal/yejingram_fork/dist

# Bun/Express upstream for ygram-proxy.noelkim12.dev
YGRAM_API_UPSTREAM=127.0.0.1:28475
